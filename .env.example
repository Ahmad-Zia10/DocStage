# Copy this file to `.env` and fill in your key.  (.env is git-ignored.)

# --- Required: the LLM that writes answers, grades and classifies ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# --- Optional: LangSmith tracing (the "flight recorder") ---
# Get a key at https://smith.langchain.com , then flip tracing on:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-key-here
# LANGCHAIN_PROJECT=docstage

# --- Required: where the docs live / where vectors persist ---
DOCS_DIR=../fastapi/docs/en/docs
CHROMA_DIR=./chroma_db

# --- Optional: retrieval mode, for A/B-ing the pipeline against the eval ---
# RETRIEVAL_MODE=hybrid     # dense | bm25 | hybrid
# RERANK=1                  # 0 disables the cross-encoder reranker
# BM25_CLEAN_TOKENS=1       # 0 uses LangChain's default whitespace tokenizer

# --- Optional: swap the embedding provider (default: huggingface, free) ---
# EMBEDDING_PROVIDER=huggingface   # or: voyage | openai
# VOYAGE_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# --- Optional: swap the LLM (must be a model your Groq key can access) ---
# LLM_MODEL=openai/gpt-oss-120b    # or: openai/gpt-oss-20b | qwen/qwen3.8-27b
