# Copy this file to `.env` and fill in your keys.  (.env is git-ignored.)

# --- Required: the LLM that writes answers ---
ANTHROPIC_API_KEY=your-key-here

# --- Optional: LangSmith tracing (the "flight recorder") ---
# Get a key at https://smith.langchain.com , then flip tracing on:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=fastapi-docs-rag

# --- Optional: where the docs live / where vectors persist ---
DOCS_DIR=../fastapi/docs/en/docs
CHROMA_DIR=./chroma_db

# --- Optional: swap the embedding provider (default: huggingface, free) ---
# EMBEDDING_PROVIDER=huggingface   # or: voyage | openai
# VOYAGE_API_KEY=your-voyage-key
# OPENAI_API_KEY=your-openai-key

# --- Optional: swap the LLM ---
# LLM_MODEL=claude-haiku-4-5-20251001   # or: claude-sonnet-5
